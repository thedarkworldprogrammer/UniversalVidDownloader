# Universal Video Downloader - Environment Variables
# Copy this file to .env and customize values

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=changeme_secure_password

# Redis Configuration (no auth by default)
# REDIS_PASSWORD=changeme_redis_password

# Server Configuration
NODE_ENV=production
PORT=3001

# Download Configuration
TEMP_DIR=/tmp/downloads
MAX_CONCURRENT_JOBS=2
REQUEST_TIMEOUT=30000

# Domain filtering (comma-separated, optional)
# BLOCKED_DOMAINS=example.com,blocked-site.com
# ALLOWED_DOMAINS=

# Client Configuration
VITE_API_URL=http://localhost:3001/api